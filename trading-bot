8. Order Execution & Fee Optimization
8.1 Order Flow
# Order Execution Pseudocode
async def execute_trade(signal, position_params):
    # 1. ตรวจสอบสถานะ Exchange
    if not await check_exchange_health(): return
    
    # 2. ตรวจสอบ Balance
    balance = await exchange.fetch_balance()
    if balance.free < position_params.margin * 1.1: return  # เผื่อ 10%
    
    # 3. ตั้ง Leverage
    await exchange.set_leverage(position_params.leverage, signal.pair)
    
    # 4. ส่ง Entry Order (Limit)
    entry_order = await exchange.create_limit_order(
        symbol=signal.pair,
        side='buy' if signal.direction == 'LONG' else 'sell',
        amount=position_params.size_coin,
        price=signal.entry  # Limit Price
    )
    log(f"Entry Order sent: {entry_order.id}")
    notify(f"Order Sent: {signal.direction} {signal.pair} @ {signal.entry}")
    
    # 5. รอ Fill (Timeout 30 นาที)
    filled = await wait_for_fill(entry_order, timeout=1800)
    if not filled:
        await exchange.cancel_order(entry_order.id)
        log("Entry Order cancelled: timeout")
        notify("Order Cancelled: ไม่ถูก Fill ใน 30 นาที")
        return
    
    # 6. ตั้ง SL ทันทีหลัง Fill
    sl_order = await exchange.create_order(
        symbol=signal.pair,
        type='stop_market',
        side='sell' if signal.direction == 'LONG' else 'buy',
        amount=position_params.size_coin,
        params={'stopPrice': signal.sl}
    )
    
    # 7. ตั้ง TP1 (40% ของ Position)
    tp1_order = await exchange.create_limit_order(
        symbol=signal.pair,
        side='sell' if signal.direction == 'LONG' else 'buy',
        amount=position_params.size_coin * 0.4,
        price=signal.tp1
    )
    
    # 8. บันทึกลง Database
    save_trade(signal, entry_order, sl_order, tp1_order)
    
    # 9. เริ่ม Monitor
    monitor.add_position(position)
