9.2 Position Monitor Logic
# Position Monitor ทำงานเป็น Loop ต่อเนื่อง
async def monitor_loop():
    while True:
        for position in get_open_positions():
            market = await get_current_market(position.pair)
            
            # 1. อัพเดท Unrealized P&L
            position.update_pnl(market.current_price)
            
            # 2. เช็ค Early Exit Conditions
            if check_time_stop(position):
                await close_position(position, "Time Stop")
                continue
            if check_ob_fail(position, market):
                await close_position(position, "OB Failed")
                continue
            if check_structure_break(position, market):
                await close_position(position, "Structure Break")
                continue
            
            # 3. เช็คว่า TP1 โดนหรือยัง → เลื่อน SL
            if position.tp1_filled and not position.sl_moved_to_be:
                await move_sl_to_breakeven(position)
            
            # 4. อัพเดท Trailing Stop (ถ้า TP1 โดนแล้ว)
            if position.tp1_filled:
                await update_trailing_stop(position, market)
            
            # 5. บันทึก State
            save_position_state(position)
            
            # 6. แจ้งเตือนถ้ามีอะไรเปลี่ยน
            if position.state_changed:
                await send_notification(position)
        
        await asyncio.sleep(5)  # ทุก 5 วินาที
