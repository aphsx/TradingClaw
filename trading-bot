11. Backtesting & Forward Testing
11.1 Backtesting Framework
ก่อนใช้เงินจริง ต้อง Backtest อย่างน้อย 6 เดือน — 1 ปี ของข้อมูลย้อนหลัง
# Backtest Structure
def backtest(strategy, candles, config):
    portfolio = Portfolio(initial_balance=config.initial_balance)
    trades = []
    
    for i in range(lookback_period, len(candles)):
        # สร้าง Market State จากข้อมูลย้อนหลัง
        market_state = build_market_state(candles[:i+1])
        
        # ตรวจสอบ Open Positions
        for position in portfolio.open_positions:
            update_position(position, candles[i])
        
        # เช็ค Entry Signal
        signal = strategy.check_entry(market_state)
        if signal:
            position_params = risk_manager.calculate(portfolio, signal)
            trade = execute_backtest_trade(signal, position_params)
            trades.append(trade)
    
    return BacktestResult(trades=trades, portfolio=portfolio)
