6.2 Trailing Stop ตาม Market Structure
# Trailing Stop Logic
def update_trailing_stop(position, market_state):
    ms = market_state
    
    if position.direction == "LONG":
        # หา HL (Higher Low) ล่าสุดบน 1H
        latest_hl = find_latest_swing_low(ms.candles_1h)
        new_sl = latest_hl.price - (ms.indicators.atr_14 * 0.3)
        
        # เลื่อน SL ขึ้นเท่านั้น ห้ามลง
        if new_sl > position.current_sl:
            position.current_sl = new_sl
            log(f"Trailing SL moved up to {new_sl}")
            notify(f"SL เลื่อนขึ้นที่ {new_sl}")
        
        # ถ้าเกิด CHoCH บน 1H → ปิด Position ทันที
        if ms.structure_1h.choch_detected and ms.structure_1h.choch_direction == "BEARISH":
            close_position(position, reason="1H CHoCH detected")
            notify("ปิด Position: Structure เสีย (CHoCH)")
6.3 Early Exit Conditions
นอกจาก SL/TP ระบบจะปิด Position ก่อนกำหนดเมื่อ:
•	Condition 1: ราคาไม่เคลื่อนไหวตาม Plan ภายใน 5 แท่ง 1H (Time Stop)
•	Condition 2: ราคา 1H ปิดใต้/เหนือ Order Block ที่เราเข้า (OB Fail)
•	Condition 3: เกิด CHoCH สวนทาง Position บน 1H (Structure Break)
•	Condition 4: Volume หายไปอย่างรุนแรง (Volume < 30% ของ MA20)
•	Condition 5: มีข่าว High Impact กำลังจะออกใน 15 นาที
 
7. Risk Management Engine
7.1 Position Sizing Formula
# Position Size Calculation
def calculate_position_size(portfolio_value, risk_pct, entry_price, sl_price, leverage):
    risk_amount = portfolio_value * (risk_pct / 100)
    sl_distance = abs(entry_price - sl_price)
    sl_distance_pct = sl_distance / entry_price
    
    # Position Size ที่ทำให้ขาดทุน = risk_amount ถ้าโดน SL
    position_size_usd = risk_amount / sl_distance_pct
    
    # ตรวจสอบว่า Leverage ไม่เกินกำหนด
    required_leverage = position_size_usd / portfolio_value
    if required_leverage > max_leverage:
        # ลด Position Size ลงแทนที่จะเพิ่ม Leverage
        position_size_usd = portfolio_value * max_leverage
    
    margin_required = position_size_usd / leverage
    
    # ตรวจว่ามี Margin เหลือพอ
    available_margin = portfolio_value - total_margin_in_use
    if margin_required > available_margin * 0.8:  # ใช้ไม่เกิน 80%
        position_size_usd = available_margin * 0.8 * leverage
    
    return PositionSizeResult(
        size_usd=position_size_usd,
        size_coin=position_size_usd / entry_price,
        margin=margin_required,
        leverage=min(required_leverage, max_leverage),
        risk_amount=risk_amount,
        actual_risk_pct=risk_pct
    )
7.2 Correlation Guard
