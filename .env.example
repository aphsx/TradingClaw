# ═══════════════════════════════════════════════════════
# TradingClaw - Binance Futures Demo Trading Configuration
# ═══════════════════════════════════════════════════════
# Copy this file to .env and fill in your values

# ─── Binance API ───────────────────────────────────────
# Get your API keys from: https://www.binance.com/en/my/settings/api-management
# For Futures Demo Trading, use your Demo API keys
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET_KEY=your_binance_secret_key_here

# ─── Trading Mode ──────────────────────────────────────
# Options:
#   - live: Real orders on Binance (use Futures Demo URL first!)
#   - paper: Simulated orders (no real execution, for testing)
#   - backtest: Historical data simulation only
TRADING_MODE=live

# ─── Market Selection ──────────────────────────────────
# Set to 'true' to use Binance Futures instead of Spot
# Futures Mainnet: https://fapi.binance.com
# Futures Demo:    https://demo-fapi.binance.com
USE_FUTURES=true

# Futures API base URL (mainnet or demo)
BINANCE_FUTURES_BASE_URL=https://demo-fapi.binance.com

# ─── Trading Pair & Timeframe ──────────────────────────
SYMBOL=BTCUSDT
TIMEFRAME=1h
LOOKBACK_DAYS=180

# ─── Risk Management ───────────────────────────────────
# INITIAL_CAPITAL is fetched automatically from your Binance balance at startup.
# Uncomment only as an emergency fallback if the API is unreachable at first boot.
# INITIAL_CAPITAL=1000
#
# Risk % per trade is set automatically based on your balance (capital tiers):
#   < $50   -> 15% risk/trade   (Micro)
#   $50-200 -> 10% risk/trade   (Small)
#   $200-500->  5% risk/trade   (Medium)
#   $500-2k ->  3% risk/trade   (Standard)
#   $2k+    ->  1% risk/trade   (Large)
MAX_DAILY_LOSS=0.05
MAX_DRAWDOWN=0.15
MAX_OPEN_TRADES=3

# ─── Database (MySQL) ──────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=regime_trader
DB_USER=trader
DB_PASSWORD=trader_pass_2026
MYSQL_ROOT_PASSWORD=regime_root_2026

# ─── Redis ─────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── Dashboard (Next.js) ───────────────────────────────
NEXT_PUBLIC_SOCKET_URL=http://localhost:8080
