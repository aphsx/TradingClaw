# ═══════════════════════════════════════════════════════
# TradingClaw - Binance Futures Demo Trading Configuration
# ═══════════════════════════════════════════════════════
# Copy this file to .env and fill in your values

# ─── Binance API ───────────────────────────────────────
# Get your API keys from: https://www.binance.com/en/my/settings/api-management
# For Futures Testnet: https://testnet.binancefuture.com
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET_KEY=your_binance_secret_key_here

# ─── Trading Mode ──────────────────────────────────────
# Options:
#   - live: Real orders on Binance (use Futures Testnet first!)
#   - paper: Simulated orders (no real execution, for testing)
#   - backtest: Historical data simulation only
TRADING_MODE=live

# ─── Market Selection ──────────────────────────────────
# Set to 'true' to use Binance Futures instead of Spot
# Futures Testnet: https://testnet.binancefuture.com
# Futures Mainnet: https://fapi.binance.com
USE_FUTURES=true

# Set to 'true' to use testnet (recommended for demo/testing)
# Testnet for Futures: https://testnet.binancefuture.com
# Testnet for Spot: https://testnet.binance.vision
USE_TESTNET=true

# ─── Trading Pair & Timeframe ──────────────────────────
SYMBOL=BTCUSDT
TIMEFRAME=1h
LOOKBACK_DAYS=180

# ─── Risk Management ───────────────────────────────────
INITIAL_CAPITAL=10000
RISK_PER_TRADE=0.02
MAX_DAILY_LOSS=0.05
MAX_DRAWDOWN=0.15
MAX_OPEN_TRADES=3

# ─── Database (MySQL) ──────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=regime_trader
DB_USER=trader
DB_PASSWORD=trader_pass_2026
MYSQL_ROOT_PASSWORD=regime_root_2026

# ─── Redis ─────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── Dashboard (Next.js) ───────────────────────────────
NEXT_PUBLIC_SOCKET_URL=http://localhost:8080
